{
  "name": "scanline",
  "private": true,
  "version": "2.0.0",
  "description": "Terminal multiplexer + scriptable browser for AI coding agents (macOS, Windows)",
  "license": "AGPL-3.0-only",
  "author": "Luiz <luizhcrs@gmail.com>",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:1420 && tsc -p tsconfig.electron.json && node scripts/write-dist-package.cjs && electron dist-electron/main.js",
    "build": "vite build && tsc -p tsconfig.electron.json && node scripts/write-dist-package.cjs && npm run build:cli",
    "build:cli": "node -e \"const{execSync}=require('child_process');const ext=process.platform==='win32'?'.exe':'';execSync('go -C ../cli build -o ../app/scanline-cli'+ext+' .',{stdio:'inherit'})\"",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ electron/",
    "lint:fix": "eslint src/ electron/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'electron/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'electron/**/*.ts'"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide": "^1.17.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.8",
    "wait-on": "^8.0.0"
  }
}
